__pycache__/
*.py[cod]
*.pyo
*.egg-info/
.venv/
venv/

# PLY debug/table artifacts
parser.out
parsetab.py

# data files created by PL/I record I/O examples
*.dat

# %INCLUDE DB2 source-repository fallback cache, and its offline demo's
# generated sqlite fixture
.pli_include_cache/
pli/examples/include_fetch_demo/include_fetch_demo.sqlite

# PyInstaller build output (built by scripts/build.py or CI; release
# binaries are attached to GitHub Releases, not committed)
/build/
/dist/
*.spec

# generated PyInstaller entry scripts (scripts/build.py and pli/build.py
# both write here instead of a temp dir, so they can be inspected after
# a build -- but they're regenerated every build, not source)
/pythoncode/

# editor/IDE-extension auto-backups seen on .pli files (not written by
# anything in this project)
.pli-snapshots/

# ad-hoc Java-transpile/native-build output left in pli/examples by the
# Java backend driver or the AI4PL/I extension's own build features --
# generated per-run, not source (javart/PLI.java is the real runtime)
pli/examples/*.exe
pli/examples/*.obj
pli/examples/*.java
