/* Self-contained variant of match.pli for Java-backend validation:
   multiple top-level EXTERNAL procedures (MAIN driver + a recursive
   external function + a sibling external function it calls). */
MDRIVER: PROC OPTIONS(MAIN);
   DCL R BIT(1);
   R = MATCH('HELLO.TXT', 'H?LLO.*');
   PUT LIST('match(HELLO.TXT, H?LLO.*) =', R);
   R = MATCH('ABC', 'A[XYZ]C');
   PUT SKIP LIST('match(ABC, A[XYZ]C)     =', R);
   R = MATCH('AXC', 'A[XYZ]C');
   PUT SKIP LIST('match(AXC, A[XYZ]C)     =', R);
   R = MATCH('ABD', 'A[XYZ]C');
   PUT SKIP LIST('match(ABD, A[XYZ]C)     =', R);
END MDRIVER;

match: procedure (txt, pattern) returns (bit(1));
   declare txt  char(*);
   declare pattern char(*);

   declare i fixed bin;
   declare j fixed bin;

   declare class char(256);
   declare k fixed bin;

   i = 1;
   j = 1;

   do while (j <= length(pattern));

      /* '*' wildcard */
      if substr(pattern, j, 1) = '*' then do;
         if j = length(pattern) then
            return('1'b);

         do i = i to length(txt);
            if match(substr(txt, i + 1),
                     substr(pattern, j + 1)) then
               return('1'b);
         end;

         return('0'b);
      end;

      if i > length(txt) then
         return('0'b);

      /* Character class */
      if substr(pattern, j, 1) = '[' then do;

         class = '';
         k = j + 1;

         do while (k <= length(pattern)
                   & substr(pattern, k, 1) ^= ']');
            class = class || substr(pattern, k, 1);
            k = k + 1;
         end;

         /* No closing ']' */
         if k > length(pattern) then
            return('0'b);

         if ^ char_in_class(substr(txt, i, 1), class) then
            return('0'b);

         j = k + 1;
         i = i + 1;
         iterate;
      end;

      /* '?' wildcard or literal */
      if substr(pattern, j, 1) ^= '?'
         & substr(pattern, j, 1) ^= substr(txt, i, 1) then
         return('0'b);

      i = i + 1;
      j = j + 1;
   end;

   if i > length(txt) then
      return('1'b);
   else
      return('0'b);

end match;

char_in_class: proc(c, class) returns(bit(1));
   declare c     char(*);
   declare class char(*);
   declare k fixed bin;
   do k = 1 to length(class);
      if substr(class, k, 1) = c then
         return('1'b);
   end;
   return('0'b);
end char_in_class;
