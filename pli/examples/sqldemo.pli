/* Embedded SQL: EXEC SQL against the AZDO0D1O connection defined in
   pli_dbc.json -- a real internal ABS-schema Db2 instance reached via
   Kerberos+SSL, NOT offline.  Needs a valid ticket/VPN access; see the
   README's Embedded SQL section.  sqldemo_db2.pli is the same style
   of demo against a plain Db2 instance (SAMPLE connection, password
   prompt) instead of the Kerberos/SSL ABS infrastructure.           */
SQLDEMO: PROC OPTIONS(MAIN);
   DCL EMPID   FIXED;
   DCL EMPNAME CHAR(12) VARYING;
   DCL DEPT    CHAR(4)  VARYING;
   DCL SAL     FIXED DEC(7,2);
   DCL (N, I)  FIXED bin(31);

   EXEC SQL INCLUDE SQLCA;
   EXEC SQL WHENEVER SQLERROR GOTO SQLFAIL;

   EXEC SQL CONNECT TO AZDO0D1O;
   PUT LIST('connected, sqlcode =', SQLCODE);

   exec sql
     select count(*) into :n
     from abs.vvertrag; 

   put skip data(n); 

   
DONE:  
   PUT SKIP(2) LIST('done, final sqlcode =', SQLCODE);
   RETURN;

SQLFAIL:
   PUT SKIP LIST('*** SQL error', SQLCODE, SQLSTATE);
   PUT SKIP LIST(SQLERRM);
END SQLDEMO;
