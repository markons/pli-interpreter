/* Stage 11: GENERIC entry selection, DO ... REPEAT, iSUB defining */
STAGE11: PROC OPTIONS(MAIN);

   /* ---- GENERIC: one name, member chosen by argument attributes ---- */
   DCL SHOW GENERIC (SHOW_BIN  WHEN (FIXED BIN),
                     SHOW_DEC  WHEN (FIXED DEC),
                     SHOW_FLT  WHEN (FLOAT),
                     SHOW_CHR  WHEN (CHAR),
                     SHOW_TWO  WHEN (*, *),
                     SHOW_VEC  WHEN ((*) FIXED BIN),
                     SHOW_ANY  OTHERWISE);
   /* PL/I(F) spelling: member ENTRY(descriptors) */
   DCL BIGGER GENERIC (MAX_FIX ENTRY (FIXED BIN, FIXED BIN),
                       MAX_STR ENTRY (CHAR, CHAR));

   DCL K       FIXED BIN(31) INIT(7);
   DCL D       FIXED DEC(7,2) INIT(12.50);
   DCL X       FLOAT INIT(2.5E0);
   DCL S       CHAR(5) INIT('HELLO');
   DCL B       BIT(4) INIT('1010'B);
   DCL V(3)    FIXED BIN(31) INIT(1, 2, 3);

   CALL SHOW(K);
   CALL SHOW(D);
   CALL SHOW(X);
   CALL SHOW(S);
   CALL SHOW(K, S);
   CALL SHOW(V);
   CALL SHOW(B);           /* no WHEN matches a BIT: OTHERWISE */
   CALL SHOW(42);          /* a decimal constant is FIXED DEC */
   CALL SHOW(K + 1);       /* FIXED BIN expression stays BIN */
   PUT SKIP LIST('BIGGER(3,9)   =', BIGGER(K - 4, K + 2));
   PUT SKIP LIST('BIGGER(AB,AC) =', BIGGER('AB', 'AC'));

   /* ---- DO REPEAT ------------------------------------------------- */
   DCL I FIXED BIN(31);
   PUT SKIP LIST('POWERS OF 2 :');
   DO I = 1 REPEAT I * 2 WHILE (I <= 100);
      PUT EDIT(I) (F(5));
   END;
   PUT SKIP LIST('UNTIL       :');
   DO I = 3 REPEAT I + 4 UNTIL (I > 15);   /* body runs before UNTIL */
      PUT EDIT(I) (F(5));
   END;

   /* linked-list walk: the classic REPEAT idiom */
   DCL 1 NODE BASED(P),
         2 VAL  FIXED BIN(31),
         2 NEXT POINTER;
   DCL (P, HEAD, Q) POINTER;
   HEAD = NULL;
   DO I = 3 TO 1 BY -1;
      ALLOCATE NODE SET(P);
      P->VAL = I * 10;
      P->NEXT = HEAD;
      HEAD = P;
   END;
   PUT SKIP LIST('LIST        :');
   DO Q = HEAD REPEAT Q->NEXT WHILE (Q ^= NULL);
      PUT EDIT(Q->VAL) (F(5));
   END;

   /* ---- iSUB defining --------------------------------------------- */
   DCL A(3,3)  FIXED BIN(31);
   DCL DIAG(3) FIXED BIN(31) DEFINED A(1SUB, 1SUB);
   DCL TR(3,3) FIXED BIN(31) DEFINED A(2SUB, 1SUB);    /* transpose */
   DCL ROW2(3) FIXED BIN(31) DEFINED A(2, 1SUB);
   DCL W(3,3)  FIXED BIN(31) DEFINED A;               /* correspondence */
   DCL (R, C)  FIXED BIN(31);
   DO R = 1 TO 3;
      DO C = 1 TO 3;
         A(R, C) = R * 10 + C;
      END;
   END;
   PUT SKIP LIST('DIAG        :');
   PUT EDIT(DIAG) ((3) F(5));
   PUT SKIP LIST('ROW2        :');
   PUT EDIT(ROW2) ((3) F(5));
   PUT SKIP LIST('TR(1,3)/W(1,3):', TR(1,3), W(1,3));
   DIAG = 0;                         /* writes through to A */
   TR(1, 2) = 99;                    /* = A(2,1) */
   PUT SKIP LIST('A AFTER     :');
   DO R = 1 TO 3;
      PUT SKIP EDIT(A(R, 1), A(R, 2), A(R, 3)) ((3) F(5));
   END;

SHOW_BIN: PROC(N);        DCL N FIXED BIN(31);
   PUT SKIP LIST('SHOW_BIN', N);  END SHOW_BIN;
SHOW_DEC: PROC(N);        DCL N FIXED DEC(7,2);
   PUT SKIP LIST('SHOW_DEC', N);  END SHOW_DEC;
SHOW_FLT: PROC(F);        DCL F FLOAT;
   PUT SKIP LIST('SHOW_FLT', F);  END SHOW_FLT;
SHOW_CHR: PROC(T);        DCL T CHAR(*);
   PUT SKIP LIST('SHOW_CHR', T);  END SHOW_CHR;
SHOW_TWO: PROC(U, T);
   PUT SKIP LIST('SHOW_TWO', U, T);  END SHOW_TWO;
SHOW_VEC: PROC(VV);       DCL VV(*) FIXED BIN(31);
   PUT SKIP LIST('SHOW_VEC', SUM(VV));  END SHOW_VEC;
SHOW_ANY: PROC(Z);
   PUT SKIP LIST('SHOW_ANY', Z);  END SHOW_ANY;
MAX_FIX: PROC(M, N) RETURNS(FIXED BIN(31));  DCL (M, N) FIXED BIN(31);
   RETURN(MAX(M, N));  END MAX_FIX;
MAX_STR: PROC(M, N) RETURNS(CHAR(10) VARYING);  DCL (M, N) CHAR(*);
   IF M > N THEN RETURN(M); RETURN(N);  END MAX_STR;
END STAGE11;
